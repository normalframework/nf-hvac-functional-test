{
  "name": "nf-hvac-functional-test",
  "version": "0.1.0",
  "private": true,
  "description": "Normal Framework app that runs AHU functional tests and an optional VAV max-cooling-airflow step.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "coverage": "node scripts/check-coverage.js",
    "validate:examples": "node scripts/validate-examples.js",
    "scan": "node scripts/scan-forbidden.js",
    "roles:sync": "node scripts/check-role-sync.js",
    "build:demo": "node scripts/build-demo.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run coverage && npm run validate:examples && npm run scan"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@types/node": "22.10.2",
    "eslint": "9.16.0",
    "globals": "15.14.0",
    "typescript": "5.7.2"
  }
}
